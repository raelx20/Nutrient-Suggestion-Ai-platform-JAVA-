# ------------------------------------------------------------------
# VitalEdge API environment template
# Copy to .env and fill in real values. Never commit real secrets.
# ------------------------------------------------------------------

# PostgreSQL (used by docker-compose to provision the container)
POSTGRES_DB=vitaledge
POSTGRES_USER=vitaledge
POSTGRES_PASSWORD=change-me-strong-password

# Application datasource
DATABASE_URL=jdbc:postgresql://localhost:5432/vitaledge
DB_USER=postgres
DB_PASSWORD=change-me

# Redis
REDIS_URL=redis://localhost:6379/0

# ------------------------------------------------------------------
# Security - REQUIRED. SECRET_KEY must be at least 32 characters.
# Generate with:  openssl rand -base64 48
# ------------------------------------------------------------------
SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
EMAIL_VERIFICATION_EXPIRE_HOURS=24

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# Redis key namespace prefix
REDIS_PREFIX=vitaledge